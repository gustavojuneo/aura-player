{
  "name": "@aura/api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "start": "node dist/server.js",
    "lint": "biome check .",
    "test": "node -e \"console.log('No tests configured')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "fastify": "^5.6.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@aura/config-typescript": "workspace:*",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.2"
  }
}
