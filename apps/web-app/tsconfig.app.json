{
  "extends": "@iptv/config-typescript/react.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": ["./src/*"],
      "@iptv/web-shared/*": ["../../packages/web-shared/src/*"]
    },
    "jsx": "react-jsx"
  },
  "include": ["src"]
}
